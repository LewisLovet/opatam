rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Administrateur Opatam — même source que les règles Firestore et que
    // `requireAdmin` côté serveur : le document utilisateur.
    function isAdminUser() {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    // Les vidéos de prestataires mises en avant sur l'accueil sont des
    // formats verticaux courts ; 60 Mo laissent de la marge sans ouvrir
    // la porte à un envoi de plusieurs centaines de mégaoctets.
    function isUnder60MB() {
      return request.resource.size < 60 * 1024 * 1024;
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Public brand assets (logos, social-share images, default
    // covers — anything served from the apps as static brand
    // resources). Read-only public; writes go through Firebase
    // Console / Admin SDK only.
    match /assets/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // User profile photos
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageType() && isUnder5MB();
    }

    // Provider photos (profile, cover, portfolio, membres, prestations)
    match /providers/{providerId}/{allPaths=**} {
      allow read: if true;
      // Le commentaire annonçait « checked via Firestore rules », mais rien
      // ne vérifiait le propriétaire ICI : tout compte connecté pouvait
      // écraser les photos d'un AUTRE prestataire. `Provider.id === User.id`,
      // donc le propriétaire se lit directement sur le chemin.
      allow write: if (isOwner(providerId) || isAdminUser()) && isImageType() && isUnder5MB();
    }

    // Vertical-landing gallery photos (one folder per vertical:
    // nail-artist, coiffeur, …). Uploaded via /admin/galleries.
    // Reads are public — the landing pages are public-facing.
    // Writes require authentication; admin authority is enforced
    // through the AdminGuard wrapper on the admin pages.
    match /landing/galleries/{slug}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminUser() && isImageType() && isUnder5MB();
    }

    // Vidéos de prestataires mises en avant sur l'accueil, envoyées depuis
    // /admin/videos — la vidéo ET son affiche. Lecture publique (la page
    // d'accueil l'est) ; écriture RÉSERVÉE AUX ADMINS : l'AdminGuard ne
    // protège que l'interface, et `isAuthenticated()` laissait n'importe
    // quel compte envoyer 60 Mo ici (audit 2026-09-19).
    match /landing/videos/{slug}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminUser()
        && ((isImageType() && isUnder5MB()) || (isVideoType() && isUnder60MB()));
    }

    // In-app notification images (uploaded from /admin/notifications).
    // Public read (shown in the app); admin-only writes.
    match /app-notifications/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminUser() && isImageType() && isUnder5MB();
    }
  }
}
